 "lines": [
  {
   "id": "K01",
   "scene": "rules",
   "start": 0.8,
   "end": 9.149,
   "sub": "这局空岛，从地图说明里的两条规矩开始：不要故意跳下去回血；不要搭桥去别的地方。"
  },
  {
   "id": "K02",
   "scene": "rules",
   "start": 9.649,
   "end": 12.637,
   "sub": "就这两条。剩下的，全靠你自己。"
  },
  {
   "id": "K03",
   "scene": "rules",
   "start": 13.137,
   "end": 23.225,
   "sub": "这张图叫 Skyblock，中文叫空岛生存。2011年9月，一个叫 Noobcrew 的玩家，把它发到了我的世界的官方论坛上。"
  },
  {
   "id": "K04",
   "scene": "tree",
   "start": 24.225,
   "end": 28.916,
   "sub": "第一件事，撸树。原木做成木板，木板做成工作台。"
  },
  {
   "id": "K05",
   "scene": "tree",
   "start": 29.316,
   "end": 33.789,
   "sub": "树苗一定要留好，掉进虚空，就再也没有树了。"
  },
  {
   "id": "K06",
   "scene": "tree",
   "start": 34.189,
   "end": 39.314,
   "sub": "这张图火得很快：同年10月，就已经出到了2.0版。"
  },
  {
   "id": "K07",
   "scene": "generator",
   "start": 40.414,
   "end": 43.365,
   "sub": "再看箱子：一桶岩浆，一块冰。"
  },
  {
   "id": "K08",
   "scene": "generator",
   "start": 43.765,
   "end": 48.238,
   "sub": "冰化了就是水；岩浆和水一碰，就变成了圆石。"
  },
  {
   "id": "K09",
   "scene": "generator",
   "start": 48.638,
   "end": 55.323,
   "sub": "这就是刷石机。空岛生存里几乎所有的东西，都是从这台小机器开始的。"
  },
  {
   "id": "K10",
   "scene": "expand",
   "start": 56.523,
   "end": 60.561,
   "sub": "有了圆石，就能一格一格地，把岛往外扩。"
  },
  {
   "id": "K11",
   "scene": "expand",
   "start": 60.961,
   "end": 69.31,
   "sub": "2012年，Noobcrew 自己开了一个服务器，叫 skyblock.net，大家可以在同一个世界里玩空岛。"
  },
  {
   "id": "K12",
   "scene": "expand",
   "start": 69.71,
   "end": 74.655,
   "sub": "后来，服务器插件让每个人都能分到一座自己的岛。"
  },
  {
   "id": "K13",
   "scene": "expand",
   "start": 74.955,
   "end": 82.254,
   "sub": "2014年9月发布的 ASkyBlock，在之后好几年里，都是最常见的空岛插件之一。"
  },
  {
   "id": "K14",
   "scene": "base",
   "start": 83.454,
   "end": 88.107,
   "sub": "岛大了，就能种地、盖房子，一点点把它变成家。"
  },
  {
   "id": "K15",
   "scene": "base",
   "start": 88.507,
   "end": 98.557,
   "sub": "2019年6月，Hypixel 推出了自己的 SkyBlock：在空岛上加了技能、经济和副本，玩起来像一款角色扮演游戏。"
  },
  {
   "id": "K16",
   "scene": "base",
   "start": 98.957,
   "end": 104.12,
   "sub": "按玩家社区的说法，它后来成了 Hypixel 上人最多的游戏。"
  },
  {
   "id": "K17",
   "scene": "oneblock",
   "start": 105.32,
   "end": 108.743,
   "sub": "也有人觉得，一座小岛还是太多了。"
  },
  {
   "id": "K18",
   "scene": "oneblock",
   "start": 109.143,
   "end": 116.188,
   "sub": "IJAMinecraft 做的 OneBlock，开局脚下只有一个方块；挖掉它，还会一直刷新出新东西。"
  },
  {
   "id": "K19",
   "scene": "trademark",
   "start": 117.388,
   "end": 124.47,
   "sub": "空岛火了，名字也值钱了。2019年11月，Noobcrew 申请把 SkyBlock 注册成商标。"
  },
  {
   "id": "K20",
   "scene": "trademark",
   "start": 124.87,
   "end": 134.268,
   "sub": "他说，只想保住这个名字，不是要独占这种玩法；可微软和一些我的世界市场的作者，提出了异议。"
  },
  {
   "id": "K21",
   "scene": "trademark",
   "start": 134.668,
   "end": 144.718,
   "sub": "2026年5月，美国的商标审判和上诉委员会裁定：Skyblock 这个词，只是在描述天上的方块岛，不能注册。"
  },
  {
   "id": "K22",
   "scene": "trademark",
   "start": 145.118,
   "end": 148.759,
   "sub": "第二天，Noobcrew 撤掉了原版地图的下载。"
  },
  {
   "id": "K23",
   "scene": "ending",
   "start": 150.059,
   "end": 153.88,
   "sub": "所以今天，空岛这个名字，谁都可以用。"
  },
  {
   "id": "K24",
   "scene": "ending",
   "start": 154.28,
   "end": 159.008,
   "sub": "可是这座 L 形的小岛，最早是他放进虚空里的。"
  },
  {
   "id": "K25",
   "scene": "ending",
   "start": 159.608,
   "end": 165.385,
   "sub": "你玩空岛，第一件做的东西是什么？评论区说说，我们下期见。"
  }
 ]
